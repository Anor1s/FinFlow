# ── Server ────────────────────────────────────────────────
PORT=3000

# Comma-separated origins are NOT supported — each var is one origin.
# LOCAL_URL is the Vite dev server, CORS_ORIGIN is the deployed frontend.
LOCAL_URL=http://localhost:5173
CORS_ORIGIN=https://anor1s.github.io

# ── Auth ──────────────────────────────────────────────────
# Use a long random string in real environments.
SECRET=change_me_to_a_long_random_string
# Lifetimes in SECONDS (code multiplies by 1000 for cookie maxAge).
ACCESS_TOKEN_EXPIRY=900
REFRESH_TOKEN_EXPIRY=604800

# ── PostgreSQL ────────────────────────────────────────────
DB_USER=postgres
DB_HOST=localhost
DB_NAME=finflow
DB_PASSWORD=your_postgres_password
DB_PORT=5432
